# Only needed when running on a physical device, where "localhost" (iOS simulator) and
# 10.0.2.2 (Android emulator) can't reach your dev machine. Point this at your machine's
# LAN IP and the backend's plain-HTTP port (5023 — see src/core/config.ts for why HTTP,
# not the HTTPS 7002 port).
#
# Copy this file to .env and restart `npm start` after editing it — EXPO_PUBLIC_ vars are
# inlined into the bundle at build/start time, not read at runtime.
EXPO_PUBLIC_API_URL=http://192.168.1.20:5023
